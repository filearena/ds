d) Find height and count total nodes.

Input:-

# Height and Total Nodes in BST

class Node:
    def __init__(self, data):
        self.data = data
        self.left = None
        self.right = None

def insert(root, data):

    if root is None:
        return Node(data)

    if data < root.data:
        root.left = insert(root.left, data)
    else:
        root.right = insert(root.right, data)

    return root

def height(root):

    if root is None:
        return 0

    left = height(root.left)
    right = height(root.right)

    return max(left, right) + 1

def countNodes(root):

    if root is None:
        return 0

    return 1 + countNodes(root.left) + countNodes(root.right)

# Main Program
root = None

for i in [50,30,70,20,40,60,80]:
    root = insert(root, i)

print("Height of BST:", height(root))

print("Total Nodes:", countNodes(root))

