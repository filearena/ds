b) Search element in BST. 

Input:-

# Search Element in BST

class Node:
    def __init__(self, data):
        self.data = data
        self.left = None
        self.right = None

def insert(root, data):
    if root is None:
        return Node(data)

    if data < root.data:
        root.left = insert(root.left, data)
    else:
        root.right = insert(root.right, data)

    return root

def search(root, key):
    if root is None:
        return False

    if root.data == key:
        return True

    elif key < root.data:
        return search(root.left, key)

    else:
        return search(root.right, key)

# Main Program
root = None

for i in [50,30,70,20,40,60,80]:
    root = insert(root, i)

key = int(input("Enter element to search: "))

if search(root, key):
    print("Element Found")
else:
    print("Element Not Found")

