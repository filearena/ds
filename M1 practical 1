d) Demonstrate stack using menu-driven program.

Input:-

# Menu Driven Stack Program

stack = []

while True:
    print("\n----- STACK MENU -----")
    print("1. Push")
    print("2. Pop")
    print("3. Peek")
    print("4. Display")
    print("5. Exit")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        item = input("Enter element: ")
        stack.append(item)
        print(item, "pushed into stack.")

    elif choice == 2:
        if len(stack) == 0:
            print("Stack is Empty.")
        else:
            print(stack.pop(), "popped from stack.")

    elif choice == 3:
        if len(stack) == 0:
            print("Stack is Empty.")
        else:
            print("Top element is:", stack[-1])

    elif choice == 4:
        if len(stack) == 0:
            print("Stack is Empty.")
        else:
            print("Stack Elements:")
            for i in range(len(stack)-1, -1, -1):
                print(stack[i])

    elif choice == 5:
        print("Program Ended.")
        break

    else:
        print("Invalid Choice!")

