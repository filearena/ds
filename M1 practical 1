b) Implement peek and display functions.

Input:- 

# Stack using Array (List)

stack = []

# Add some elements into the stack
stack.append(10)
stack.append(20)
stack.append(30)
stack.append(40)

# Peek Function
def peek():
    if len(stack) == 0:
        print("Stack is Empty")
    else:
        print("Top Element is:", stack[-1])

# Display Function
def display():
    if len(stack) == 0:
        print("Stack is Empty")
    else:
        print("Stack Elements are:")
        for i in range(len(stack)-1, -1, -1):
            print(stack[i])

# Function Calls
peek()
display()

Output:-

c) Check overflow and underflow conditions.

Input:-

# Stack Overflow and Underflow Program

MAX = 3
stack = []

# Push Function
def push(item):
    if len(stack) == MAX:
        print("Stack Overflow!")
    else:
        stack.append(item)
        print(item, "inserted into stack.")

# Pop Function
def pop():
    if len(stack) == 0:
        print("Stack Underflow!")
    else:
        item = stack.pop()
        print(item, "removed from stack.")

# Demonstration
push(10)
push(20)
push(30)
push(40)      # Overflow

pop()
pop()
pop()
pop()         # Underflow

