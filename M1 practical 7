c). Implement Chaining Method

Input:-

# Chaining Method

size = 10

hash_table = []

for i in range(size):
    hash_table.append([])

def insert(key):

    index = key % size

    hash_table[index].append(key)

    print(key, "inserted at index", index)

# Main Program
insert(25)
insert(35)
insert(45)

print("Hash Table")

for i in range(size):
    print(i, ":", hash_table[i])

