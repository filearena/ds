7(b). Handle Collisions Using Linear Probing

Input:-

# Linear Probing

size = 10
hash_table = [None] * size

def insert(key):

    index = key % size

    while hash_table[index] is not None:
        index = (index + 1) % size

    hash_table[index] = key

    print(key, "inserted at index", index)

# Main Program
insert(25)
insert(35)
insert(45)

print("Hash Table:")
print(hash_table)

