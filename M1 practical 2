# Check Balanced Parentheses

def check_balance(expression):

    stack = []

    for ch in expression:

        if ch == '(':
            stack.append(ch)

        elif ch == ')':

            if len(stack) == 0:
                return "Not Balanced"

            stack.pop()

    if len(stack) == 0:
        return "Balanced"

    return "Not Balanced"

expr = input("Enter Expression: ")

