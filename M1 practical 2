# Stack Implementation using Singly Linked List

class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

class Stack:
    def __init__(self):
        self.top = None

    # Push Operation
    def push(self, data):
        new_node = Node(data)
        new_node.next = self.top
        self.top = new_node
        print(data, "pushed into stack.")

    # Pop Operation
    def pop(self):
        if self.top is None:
            print("Stack Underflow")
        else:
            temp = self.top
            self.top = self.top.next
            print(temp.data, "popped from stack.")

    # Display Stack
    def display(self):
        if self.top is None:
            print("Stack is Empty")
        else:
            temp = self.top
            print("Stack Elements:")
            while temp:
                print(temp.data)
                temp = temp.next

# Main Program
s = Stack()

s.push(10)
s.push(20)
s.push(30)

s.display()

s.pop()

s.display()

