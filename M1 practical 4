b) Implement priority queue.

Input:- 

# Priority Queue

queue = []

def insert(data, priority):
    queue.append((priority, data))
    queue.sort()

def delete():
    if len(queue) == 0:
        print("Priority Queue is Empty")
    else:
        item = queue.pop(0)
        print("Deleted:", item)

def display():
    print("Priority Queue:")
    for item in queue:
        print(item)

# Main Program
