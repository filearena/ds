c) Implement Circular Queue

Input:-

# Circular Queue

SIZE = 5
queue = [None] * SIZE

front = -1
rear = -1

def enqueue(item):
    global front, rear

    if (rear + 1) % SIZE == front:
        print("Queue Overflow")

    elif front == -1:
        front = rear = 0
        queue[rear] = item

    else:
        rear = (rear + 1) % SIZE
        queue[rear] = item

def dequeue():
    global front, rear

    if front == -1:
        print("Queue Underflow")

    else:
        print(queue[front], "deleted")

        if front == rear:
            front = rear = -1
        else:
            front = (front + 1) % SIZE

def display():

    if front == -1:
        print("Queue Empty")
        return

    i = front

    while True:
        print(queue[i], end=" ")

        if i == rear:
            break

        i = (i + 1) % SIZE

    print()

enqueue(10)
enqueue(20)
enqueue(30)
enqueue(40)
enqueue(50)

display()

dequeue()

display()

enqueue(60)

display()

